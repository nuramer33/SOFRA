# ---- Production checklist (on the VPS) ----
# APP_ENV=production   APP_DEBUG=false   APP_URL=https://your-domain
# LOG_STACK=daily      LOG_LEVEL=warning
# SESSION_SECURE_COOKIE=true
# MAIL_MAILER=smtp + real MAIL_HOST/PORT/USERNAME/PASSWORD/MAIL_FROM_ADDRESS, then: php artisan sofra:mail-test you@email.com
# Cron:  * * * * * cd /path/to/sofra && php artisan schedule:run   (runs the nightly backup)
# Deploy: composer install --no-dev -o && npm ci && npm run build && php artisan migrate --force && php artisan optimize && php artisan storage:link
# -------------------------------------------
APP_NAME=Sofra
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sofra
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Platform subscription + support (shown on the landing page and legal pages)
SOFRA_MONTHLY_PRICE="$12"
SOFRA_SUPPORT_WHATSAPP=
SOFRA_SUPPORT_EMAIL=
# Backups: how many days to keep, and the path of mysqldump if it is not on PATH
# SOFRA_BACKUP_KEEP_DAYS=14
# SOFRA_MYSQLDUMP=mysqldump

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# What the public menu does once a subscription has expired: visible | read_only | suspended
SOFRA_EXPIRED_MENU=read_only

# Automatic monthly payment (Stripe). Leave empty to keep payments manual.
# STRIPE_SECRET=sk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
