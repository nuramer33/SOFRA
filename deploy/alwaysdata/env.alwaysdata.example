# Sofra on alwaysdata (free plan). install-release.sh copies this to .env the first time
# and fills __ACCOUNT__. YOU then type the database values below in the file on the
# server (never send them to anyone, never put them on GitHub).

APP_NAME=Sofra
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://__ACCOUNT__.alwaysdata.net
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Create the database in the alwaysdata admin: Databases > MySQL > Add, then
# add a database user. Copy the exact host, database and user names it shows.
DB_CONNECTION=mysql
DB_HOST=mysql-__ACCOUNT__.alwaysdata.net
DB_PORT=3306
DB_DATABASE=__DB_NAME__
DB_USERNAME=__DB_USER__
DB_PASSWORD=__DB_PASSWORD__

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Emails are written to storage/logs until you set up SMTP (free: Brevo, 300/day).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SOFRA_MONTHLY_PRICE="$5"
SOFRA_SUPPORT_WHATSAPP=
SOFRA_SUPPORT_EMAIL=
SOFRA_EXPIRED_MENU=read_only
SOFRA_BACKUP_KEEP_DAYS=7

# Leave Stripe OFF here: alwaysdata's free plan may not be used for profit.
# STRIPE_SECRET=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=
